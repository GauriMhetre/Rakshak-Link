# Rakshak Link Configuration

# Embedding Backend: insightface | synthetic (default)
EMBEDDING_BACKEND=synthetic

# Database (SQLite for demo; use PostgreSQL in production)
DATABASE_URL=sqlite:///./rakshak_link.db

# API Host & Port
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Dev Server Port
FRONTEND_PORT=3000

# Authentication (demo: header-based; production: JWT)
DEMO_MODE=true
